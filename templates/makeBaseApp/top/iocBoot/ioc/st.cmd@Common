#!../../bin/_ARCH_/_APPNAME_
#-- A failing command stops this script and the IOC exits with a nonzero status.
on error break
#--
< envPaths
#--
cd "${TOP}"
#--
#--https://epics-controls.org/resources-and-support/documents/howto-documents/channel-access-reach-multiple-soft-iocs-linux/
#--if one needs connections between IOCs on one host
#--add the broadcast address of the lookback interface to each IOC setting
epicsEnvSet("EPICS_CA_ADDR_LIST","127.255.255.255")
#--epicsEnvSet("EPICS_CA_AUTO_ADDR_LIST","YES")

#-- PVA Environment Variables
#-- epicsEnvSet("EPICS_PVA_ADDR_LIST","")
#-- epicsEnvSet("EPICS_PVAS_BEACON_ADDR_LIST","")
#-- epicsEnvSet("EPICS_PVA_AUTO_ADDR_LIST","")
#-- epicsEnvSet("EPICS_PVAS_AUTO_BEACON_ADDR_LIST","")
#-- epicsEnvSet("EPICS_PVAS_INTF_ADDR_LIST","")
#-- epicsEnvSet("EPICS_PVA_SERVER_PORT","")
#-- epicsEnvSet("EPICS_PVAS_SERVER_PORT","")
#-- epicsEnvSet("EPICS_PVA_BROADCAST_PORT","")
#-- epicsEnvSet("EPICS_PVAS_BROADCAST_PORT","")
#-- epicsEnvSet("EPICS_PVAS_IGNORE_ADDR_LIST","")
#-- epicsEnvSet("EPICS_PVA_CONN_TMO","")
#--
epicsEnvSet("DB_TOP",                "$(TOP)/db")
epicsEnvSet("EPICS_DB_INCLUDE_PATH", "$(DB_TOP)")
epicsEnvSet("STREAM_PROTOCOL_PATH",  "$(DB_TOP)")
epicsEnvSet("IOCSH_LOCAL_TOP",       "$(TOP)/iocsh")
#-- IOCSH_TOP is the commonIocsh layer; a fragment loads as $(IOCSH_TOP)/iocsh/<fragment>.iocsh.
epicsEnvSet("IOCSH_TOP",            "$(EPICS_BASE)/../modules/commonIocsh")
#--
#-- Operational metadata: the ioc-runner .conf IOC_META_* keys are the
#-- source of truth; the three values below are a startup-visible mirror.
epicsEnvSet("ENGINEER",  "_USER_")
epicsEnvSet("LOCATION",  "_LOCATION_")
epicsEnvSet("WIKI", "")
#-- 
epicsEnvSet("IOCNAME", "_IOCNAME_")
epicsEnvSet("IOC", "_IOC_")
#--
epicsEnvSet("PRE", "AAAA:")
epicsEnvSet("REC", "BBBB:")

dbLoadDatabase "dbd/_APPNAME_.dbd"
_CSAFEAPPNAME__registerRecordDeviceDriver pdbbase

#--
#-- The following termination defintion should be in st.cmd or .iocsh. 
#-- Mostly, it should be .iocsh file. Please don't use them within .proto file
#--
#-- <0x0d> \r
#-- <0x0a> \n
#-- asynOctetSetInputEos($(PORT), 0, "\r")
#-- asynOctetSetOutputEos($(PORT), 0, "\r")

#--
#-- Common iocsh fragment example. The commonIocsh layer comes with EPICS-env 1.4.0
#-- and later; a missing fragment stops this script. linStat.iocsh also needs LINSTAT
#-- in configure/RELEASE, and linStat.dbd with the linStat library in src/Makefile.
#-- iocshLoad("$(IOCSH_TOP)/iocsh/linStat.iocsh", "IOC=$(IOCNAME)")

cd "${TOP}/iocBoot/${IOC}"

#--epicsEnvSet("PORT1",      "AABBCCDD")
#--epicsEnvSet("PORT1_IP",   "xxx.xxx.xxx.xxx")
#--epicsEnvSet("PORT1_PORT", "xxxx")
#--iocshLoad("$(IOCSH_LOCAL_TOP)/_APPNAME_.iocsh", "P=$(PRE),R=$(REC),DATABASE_TOP=$(DB_TOP),PORT=$(PORT1),IPADDR=$(PORT1_IP),IPPORT=$(PORT1_PORT)")

#>>>>>>>>>>>>>
iocInit
#>>>>>>>>>>>>>
#-- Enable the next line to keep a running IOC alive when a command below fails.
#-- on error continue
##
epicsEnvShow > $(TARGET_TOP=/opt)/epics-pvinfo/env/$(IOCNAME).softioc
dbl > $(TARGET_TOP=/opt)/epics-pvinfo/names/$(IOCNAME)
